# =============================================================================
# Provider 切換：改下面這行就好，程式碼不用動。
# 注意：Gemini / Groq / free cloud keys 只適合 dev / synthetic data。
# 真實 GIIS 學生資料請用 local/private provider path，例如 Ollama 或經核准的私有部署。
# =============================================================================
LLM_MODEL=gemini/gemini-2.5-flash
LLM_TIMEOUT_SECONDS=45

# =============================================================================
# Mode boundary
# dev：只有 SHOW_RAW_CONVERSATIONS=1 或 UMI_DEV_MODE=1 時才顯示 raw conversations
# demo：不顯示 raw conversations / scenario seeds / secret truths
# pilot：privacy-first UI；不得顯示 raw conversations 或 synthetic-hidden labels
# =============================================================================
APP_MODE=demo
SHOW_RAW_CONVERSATIONS=0
UMI_DEV_MODE=0

# =============================================================================
# 選一個你要用的 provider，填入對應的 API key（不用全填）
# =============================================================================

# Dev only：Gemini Flash — 免費額度大，去 https://aistudio.google.com/ 拿
GEMINI_API_KEY=your-key-here

# Claude（最強，但要付費；真實資料需先確認資料處理條款）
# ANTHROPIC_API_KEY=your-key-here

# DeepSeek（中國端，極便宜，品質不錯；杰尼/中國端部署需另做合規確認）
# DEEPSEEK_API_KEY=your-key-here

# Dev only：Groq（推論超快，有免費額度）
# GROQ_API_KEY=your-key-here

# OpenAI
# OPENAI_API_KEY=your-key-here

# =============================================================================
# Ollama 本地（完全免費 + 隱私）：不需要 key
# 1. 安裝 Ollama → https://ollama.com/
# 2. 拉個模型：  ollama pull llama3.2
# 3. 確認 server 跑著：ollama serve（macOS app 預設背景跑）
# 4. 把上面 LLM_MODEL 改成：ollama/qwen2.5:14b 或 ollama/llama3.2
# =============================================================================

# =============================================================================
# 完整 model 字串清單看：https://docs.litellm.ai/docs/providers
# =============================================================================
